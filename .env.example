VITE_GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com

# Server-side only (used by the api/* serverless functions, not the Vite build).
# Not needed for `npm run dev` — only for `vercel dev` or production.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Which provider the AI endpoints (theme/habit/breakdown) call. Defaults to
# 'openai'. Set to 'anthropic' to revert to claude-haiku-4-5 (the previous
# default) as a rollback.
AI_PROVIDER=
# Overrides the model for the active provider. Defaults to gpt-5.6-luna
# (openai) or claude-haiku-4-5 (anthropic) when unset.
AI_MODEL=
# Optional: activates the per-user daily call cap on the AI endpoints
# (theme/habit/breakdown). Without these set, the cap is skipped
# (fails open) and only the Google token auth check applies.
# Set by the Upstash-for-Redis Vercel Marketplace integration — copy these
# two from the integration's env vars (it also injects
# KV_REST_API_READ_ONLY_TOKEN, KV_URL, and REDIS_URL, which are unused here).
KV_REST_API_URL=
KV_REST_API_TOKEN=
